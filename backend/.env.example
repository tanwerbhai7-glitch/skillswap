# SkillSwap backend environment
# Copy this file to .env and put your local MySQL password in DB_PASSWORD.
# Never commit the real .env file.

PORT=5000
NODE_ENV=development

# MySQL
DB_HOST=localhost
DB_USER=root
DB_PASSWORD=
DB_NAME=skillswap
DB_PORT=3306

# Frontend CORS
CLIENT_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:8080

# Reserved for future JWT authentication
JWT_SECRET=
JWT_EXPIRES_IN=7d
